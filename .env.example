# CodePilot API — example configuration.
# Copy to `.env` for local development. Never commit `.env` or real secrets.
# `VITE_*` variables are public in the browser bundle; server variables are not.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=8787
# Many platform hosts also set PORT. `npm start` uses PORT as API_PORT when API_PORT is unset.
PORT=

# Required in production. Leave empty locally to use the in-memory store.
# Example: postgresql://codepilot:password@127.0.0.1:5432/codepilot
DATABASE_URL=

# Comma-separated exact origins. Wildcards are rejected.
# In development the Vite ports 5173/4173/4180 are allowed automatically.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Sessions and credentials
# ---------------------------------------------------------------------------
SESSION_COOKIE_NAME=codepilot_session
SESSION_TTL_DAYS=30
SESSION_COOKIE_SECURE=false

# Required in production: base64-encoded 32 bytes.
# Generate with: openssl rand -base64 32
CREDENTIAL_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# AI gateway
# ---------------------------------------------------------------------------
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_MESSAGES=40
AI_MAX_MESSAGE_CHARS=120000
# Allow loopback/private endpoints for local Ollama. Keep false on public servers.
ALLOW_PRIVATE_AI_ENDPOINTS=true
MAX_BODY_BYTES=2000000
TRUST_PROXY=false

# Managed CodePilot AI. Leave URL, key and model empty to disable managed mode.
# The key is read only by the API process and is never returned to the browser.
# Providers: openai, anthropic, gemini, ollama, deepseek, openai-compatible.
MANAGED_AI_PROVIDER=openai-compatible
MANAGED_AI_LABEL=CodePilot AI
MANAGED_AI_BASE_URL=
MANAGED_AI_API_KEY=
MANAGED_AI_MODEL=
MANAGED_AI_DAILY_REQUESTS=100
MANAGED_AI_MONTHLY_TOKENS=500000
MANAGED_AI_FALLBACK_MODELS=

# ---------------------------------------------------------------------------
# Local execution companion (separate process: npm run exec)
# ---------------------------------------------------------------------------
# EXEC_PORT=5310
# EXEC_HOST=127.0.0.1
# EXEC_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# EXEC_MAX_CONCURRENCY=2
# Remote bind is refused unless both are set. This is still not a sandbox.
# EXEC_ALLOW_REMOTE=0
# EXEC_TOKEN=
