{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CodePilot Lab: Start All",
      "type": "shell",
      "command": "npm run dev:all",
      "isBackground": true,
      "problemMatcher": {
        "owner": "codepilot-lab",
        "severity": "info",
        "pattern": {
          "regexp": "^(.*)$",
          "file": 1,
          "message": 1
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Starting CodePilot Lab development environment.*",
          "endsPattern": ".*All CodePilot Lab services started.*"
        }
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "CodePilot Lab: Check",
      "type": "shell",
      "command": "npm run check",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "CodePilot Lab: Verify",
      "type": "shell",
      "command": "npm run verify",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "CodePilot Lab: Doctor",
      "type": "shell",
      "command": "npm run doctor",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
